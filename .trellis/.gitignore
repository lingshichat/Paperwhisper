# Developer identity (local only)
.developer

# Current task pointer (each dev works on different task)
.current-task

# Ralph Loop state file
.ralph-state.json

# Agent runtime files
.agents/
.agent-log
.session-id
worktrees/

# Template/runtime metadata
.template-hashes.json
.runtime/
.cache/

# Task directory runtime files
.plan-log
tasks/**/*.jsonl
tasks/**/.plan-log

# Developer workspace records
workspace/

# Task working records (local workflow state)
tasks/*/task.json
tasks/*/prd.md
tasks/archive/

# Atomic update temp files
*.tmp

# Update backup directories
.backup-*

# Conflict resolution temp files
*.new

# Python cache
**/__pycache__/
**/*.pyc
