* text=auto

# Source code and docs should stay LF across platforms.
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.css text eol=lf
*.dart text eol=lf
*.gradle text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.html text eol=lf
*.java text eol=lf
*.js text eol=lf
*.json text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.manifest text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.py text eol=lf
*.rc text eol=lf
*.sh text eol=lf
*.swift text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Windows-native scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.iss text eol=crlf
*.isl text eol=crlf
*.ps1 text eol=crlf

# Treat common binaries as binary.
*.a binary
*.apk binary
*.bmp binary
*.dll binary
*.dylib binary
*.exe binary
*.gif binary
*.ico binary
*.jar binary
*.jpeg binary
*.jpg binary
*.keystore binary
*.lib binary
*.otf binary
*.p12 binary
*.pdf binary
*.png binary
*.so binary
*.ttf binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
